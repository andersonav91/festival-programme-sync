<div class="overflow-x-auto rounded-lg border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= screenings_sort_link("Film", :film, pagination) %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= screenings_sort_link("Venue", :venue, pagination) %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= screenings_sort_link("Starts", :starts, pagination) %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= screenings_sort_link("Status", :status, pagination) %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% screenings.each do |screening| %>
        <tr>
          <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= screening.film.title %></td>
          <td class="px-4 py-3 text-sm text-gray-700"><%= screening.venue.name %></td>
          <td class="px-4 py-3 text-sm text-gray-700"><%= screening.starts_at.strftime("%a %d %b %Y, %-l:%M%P") %></td>
          <td class="px-4 py-3 text-sm">
            <% if screening.cancelled? %>
              <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Cancelled</span>
            <% else %>
              <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Scheduled</span>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if screenings.empty? %>
        <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">No screenings match your filters.</td></tr>
      <% end %>
    </tbody>
  </table>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700">
    <p>
      Page <%= pagination.page %> of <%= pagination.total_pages %> -
      <%= pluralize(pagination.total_count, "screening") %>
    </p>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Export CSV",
            screenings_export_path,
            data: { turbo_frame: "_top" },
            class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100" %>

      <% if pagination.previous_page %>
        <%= link_to "Previous",
              screenings_page_path(pagination.previous_page),
              data: { turbo_frame: "screenings" },
              class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100" %>
      <% else %>
        <span class="rounded-md border border-gray-200 bg-gray-100 px-3 py-1.5 font-medium text-gray-400">Previous</span>
      <% end %>

      <% screenings_page_items(pagination).each do |page| %>
        <% if page == :gap %>
          <span class="px-1 py-1.5 font-medium text-gray-400">...</span>
        <% elsif page == pagination.page %>
          <span class="rounded-md border border-gray-900 bg-gray-900 px-3 py-1.5 font-medium text-white"><%= page %></span>
        <% else %>
          <%= link_to page,
                screenings_page_path(page),
                data: { turbo_frame: "screenings" },
                class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100" %>
        <% end %>
      <% end %>

      <% if pagination.next_page %>
        <%= link_to "Next",
              screenings_page_path(pagination.next_page),
              data: { turbo_frame: "screenings" },
              class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100" %>
      <% else %>
        <span class="rounded-md border border-gray-200 bg-gray-100 px-3 py-1.5 font-medium text-gray-400">Next</span>
      <% end %>
    </div>
  </div>
</div>
